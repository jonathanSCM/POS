generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// TYPES (SQLite uses strings instead of enums)
// ─────────────────────────────────────────────
// Valid values:
// Role: ADMIN, MANAGER, CASHIER
// UnitType: UNIT, KG, LITER, BOX
// StockMovementType: PURCHASE_IN, SALE_OUT, RETURN_IN, ADJUSTMENT_IN, ADJUSTMENT_OUT, VOID_RESTOCK, TRANSFER_OUT, TRANSFER_IN
// StockTransferStatus: PENDING, IN_TRANSIT, RECEIVED, CANCELLED
// PurchaseOrderStatus: DRAFT, RECEIVED, CANCELLED
// PurchaseOrder.paymentStatus: PENDING, PARTIAL, PAID
// SaleStatus: HELD, COMPLETED, VOIDED, RETURNED, PARTIALLY_RETURNED
// PaymentMethod: CASH, CARD, QR, TRANSFER, CREDIT
// Sale.paymentStatus: PAID, PENDING
// CashMovementType: SALE_CASH_IN, PAID_IN, PAID_OUT, REFUND_CASH_OUT
// RegisterSessionStatus: OPEN, CLOSED
// AuditAction: SALE_VOID, STOCK_ADJUSTMENT, PRICE_CHANGE, REGISTER_DISCREPANCY, USER_CREATED, USER_PASSWORD_RESET, RETURN_PROCESSED, CASH_MANUAL_MOVEMENT

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("CASHIER")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Sucursal preseleccionada al iniciar sesion (para ADMIN es solo un valor
  // inicial comodo; para MANAGER/CASHIER sin acceso a varias sucursales
  // suele coincidir con su unica sucursal asignada en UserBranch).
  defaultBranchId String?
  defaultBranch   Branch?  @relation(fields: [defaultBranchId], references: [id])
  branches        UserBranch[]

  salesAsCashier      Sale[]                @relation("SaleCashier")
  voidedSales         Sale[]                @relation("SaleVoidedBy")
  stockMovements      StockMovement[]
  registerSessions    CashRegisterSession[]
  cashMovements       CashMovement[]
  auditLogs           AuditLog[]
  purchaseOrdersMade  PurchaseOrder[]
  returnsProcessed    Return[]
  customerPayments    CustomerPayment[]
  supplierPayments    SupplierPayment[]
  transfersRequested  StockTransfer[]       @relation("TransferRequestedBy")
  transfersReceived   StockTransfer[]       @relation("TransferReceivedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// SUCURSALES (BRANCHES)
// ─────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usersDefault     User[]
  userBranches     UserBranch[]
  productStocks    ProductStock[]
  batches          ProductBatch[]
  stockMovements   StockMovement[]
  sales            Sale[]
  registerSessions CashRegisterSession[]
  purchaseOrders   PurchaseOrder[]
  transfersFrom    StockTransfer[]       @relation("TransferFrom")
  transfersTo      StockTransfer[]       @relation("TransferTo")

  @@map("branches")
}

// Acceso de un usuario a una sucursal. Los ADMIN no necesitan filas aca: se
// consideran con acceso implicito a todas las sucursales activas.
model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@map("user_branches")
}

// ─────────────────────────────────────────────
// PRODUCTS & INVENTORY
// ─────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
  batches        ProductBatch[]

  @@map("suppliers")
}

model Product {
  id               String   @id @default(cuid())
  sku              String   @unique
  barcode          String?  @unique
  name             String
  description      String?  
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  costPrice        Decimal
  salePrice        Decimal
  minStockAlert    Decimal   @default(0)
  unitType         String @default("UNIT")
  imageUrl         String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  saleLines           SaleLine[]
  stockMovements      StockMovement[]
  batches             ProductBatch[]
  purchaseOrderLines  PurchaseOrderLine[]
  returnLines         ReturnLine[]
  stocks              ProductStock[]
  transferLines       StockTransferLine[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// Cantidad en stock de un producto en una sucursal puntual. Una sucursal
// sin fila para un producto se interpreta como stock 0 (no hace falta
// precrear una fila por cada producto al dar de alta una sucursal nueva).
model ProductStock {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qty       Decimal  @default(0)
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("product_stocks")
}

model ProductBatch {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  batchNumber      String
  quantity         Decimal
  qtyRemaining     Decimal
  expiryDate       DateTime?
  receivedDate     DateTime  @default(now())
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  stockMovements   StockMovement[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([productId, branchId, batchNumber])
  @@index([expiryDate])
  @@index([productId])
  @@index([branchId])
  @@map("product_batches")
}

model StockMovement {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id])
  batchId          String?
  batch            ProductBatch?     @relation(fields: [batchId], references: [id])
  type             String
  quantity         Decimal           
  qtyBefore        Decimal           
  qtyAfter         Decimal           
  reason           String?
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  saleId           String?
  sale             Sale?             @relation(fields: [saleId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  returnId         String?
  return           Return?           @relation(fields: [returnId], references: [id])
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([branchId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  code        String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  status      String @default("DRAFT")
  notes       String?
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  receivedAt  DateTime?

  // Cuentas por pagar: monto total de la orden (suma de lineas al crearla),
  // fecha de vencimiento opcional, y estado de pago segun lo que se le haya
  // abonado al proveedor (SupplierPayment).
  totalAmount   Decimal  @default(0)
  dueDate       DateTime?
  paymentStatus String   @default("PENDING") // PENDING, PARTIAL, PAID

  lines           PurchaseOrderLine[]
  stockMovements  StockMovement[]
  batches         ProductBatch[]
  payments        SupplierPayment[]

  @@map("purchase_orders")
}

// Abono a una orden de compra puntual (a diferencia del cliente, aca si se
// paga orden por orden porque cada una tiene su propia fecha de vencimiento).
model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal
  method          String // CASH, CARD, QR, TRANSFER
  note            String?
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@map("supplier_payments")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       
  unitCost        Decimal       

  @@map("purchase_order_lines")
}

// ─────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────

model Customer {
  id                  String   @id @default(cuid())
  name                String
  phone               String
  taxId               String?
  email               String?
  address             String?
  // Saldo de cuenta corriente del cliente: negativo = el cliente debe (fiado
  // pendiente), positivo = a favor del cliente (pago de mas / credito
  // prepagado). Las ventas a credito lo restan, los abonos (CustomerPayment)
  // lo suman.
  storeCreditBalance  Decimal   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
  @@index([phone])
  @@index([taxId])
  @@map("customers")
}

// Abono de un cliente a su cuenta corriente (paga parte o todo lo que debia
// de ventas a credito anteriores). No esta ligado a una venta puntual: el
// fiado se maneja como saldo de cuenta, no factura por factura.
model CustomerPayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal
  method     String // CASH, CARD, QR, TRANSFER
  note       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_payments")
}

// ─────────────────────────────────────────────
// SALES (POS core)
// ─────────────────────────────────────────────

model Sale {
  id                String      @id @default(cuid())
  code              String      @unique
  status            String  @default("HELD")
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerName      String?
  cashierId         String
  cashier           User        @relation("SaleCashier", fields: [cashierId], references: [id])
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id])
  registerSessionId String?
  registerSession   CashRegisterSession? @relation(fields: [registerSessionId], references: [id])

  subtotal          Decimal
  discountTotal     Decimal      @default(0)
  taxTotal          Decimal      @default(0)
  total             Decimal

  // PAID: se cobro al momento (efectivo/tarjeta/QR/transferencia).
  // PENDING: venta a credito ("fiado") -- el saldo vive en
  // Customer.storeCreditBalance, no se rastrea pago parcial por venta.
  paymentStatus        String   @default("PAID")
  // Solo se completa en ventas a credito (paymentStatus PENDING al crear):
  // fecha limite para pagar, usada para calcular "vencido desde hace N dias"
  // en las notificaciones de cuentas por cobrar.
  creditDueDate        DateTime?

  isInvoiced           Boolean  @default(false)
  invoiceNumber        Int?     @unique
  customerTaxId        String?
  customerBusinessName String?
  publicToken          String?  @unique

  heldAt            DateTime?
  completedAt       DateTime?

  voidedById        String?
  voidedBy          User?       @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidedAt          DateTime?
  voidReason        String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lines             SaleLine[]
  payments          Payment[]
  stockMovements    StockMovement[]
  returns           Return[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([cashierId])
  @@index([branchId])
  @@map("sales")
}

model SaleLine {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  productName   String
  unitPrice     Decimal  
  quantity      Decimal  
  lineDiscount  Decimal   @default(0)
  lineTotal     Decimal  

  returnLines   ReturnLine[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_lines")
}

model Payment {
  id                String        @id @default(cuid())
  saleId            String
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method            String
  amount            Decimal       
  amountTendered    Decimal?      
  changeGiven       Decimal?      
  reference         String?
  createdAt         DateTime      @default(now())

  @@index([saleId])
  @@map("payments")
}

// ─────────────────────────────────────────────
// RETURNS
// ─────────────────────────────────────────────

model Return {
  id              String   @id @default(cuid())
  code            String   @unique
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id])
  processedById    String
  processedBy     User     @relation(fields: [processedById], references: [id])
  reason          String?
  totalRefunded   Decimal  
  refundMethod    String
  createdAt       DateTime @default(now())

  lines           ReturnLine[]
  stockMovements  StockMovement[]

  @@map("returns")
}

model ReturnLine {
  id              String   @id @default(cuid())
  returnId        String
  return          Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLineId      String
  saleLine        SaleLine @relation(fields: [saleLineId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Decimal  
  refundAmount    Decimal  

  @@map("return_lines")
}

// ─────────────────────────────────────────────
// CASH REGISTER SESSIONS
// ─────────────────────────────────────────────

model CashRegisterSession {
  id              String                 @id @default(cuid())
  code            String                 @unique
  openedById      String
  openedBy        User                   @relation(fields: [openedById], references: [id])
  branchId        String
  branch          Branch                 @relation(fields: [branchId], references: [id])
  status          String  @default("OPEN")

  startingCash    Decimal                
  expectedCash    Decimal?               
  countedCash     Decimal?               
  discrepancy     Decimal?               
  notes           String?

  openedAt        DateTime               @default(now())
  closedAt        DateTime?

  sales           Sale[]
  cashMovements   CashMovement[]

  @@index([branchId])
  @@map("cash_register_sessions")
}

model CashMovement {
  id          String            @id @default(cuid())
  sessionId   String
  session     CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal           
  note        String?
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([sessionId])
  @@map("cash_movements")
}

// ─────────────────────────────────────────────
// SETTINGS (singleton)
// ─────────────────────────────────────────────

model StoreSettings {
  id                  String   @id @default(cuid())
  storeName           String   @default("Mi Tienda")
  logoUrl             String?
  currencySymbol      String   @default("$")
  taxRatePercent      Decimal   @default(0)
  receiptFooterText   String?
  receiptPaperWidth   String   @default("80mm")

  // Notificaciones (WhatsApp/email) -- ver lib/notifications/
  notifyPhone            String?
  notifyEmail             String?
  bigSaleThreshold        Decimal  @default(1000)
  bigAdjustmentThreshold  Decimal  @default(20)
  creditTermDays          Int      @default(30)
  whatsappEnabled         Boolean  @default(false)
  emailEnabled            Boolean  @default(false)
  // Hora del dia (0-23, hora Bolivia) en la que corren los chequeos
  // periodicos -- ver instrumentation.ts. La mayoria de las notificaciones
  // son instantaneas (se disparan al momento del evento, no por chequeo);
  // esto solo afecta al resumen diario/cuentas vencidas y al resumen
  // semanal (que ademas solo corre los lunes).
  dailyCheckHour          Int      @default(20)
  weeklyCheckHour         Int      @default(8)

  updatedAt           DateTime @updatedAt

  @@map("store_settings")
}

// Preferencia del admin de recibir (o no) cada tipo de notificacion --
// ver lib/notifications/preferences.ts. Sin fila para un type = habilitado
// (comportamiento por defecto), asi que no hace falta sembrar las 16 filas.
model NotificationPreference {
  id      String  @id @default(cuid())
  type    String  @unique
  enabled Boolean @default(true)

  @@map("notification_preferences")
}

// Auditoria de notificaciones enviadas (WhatsApp/email) y mecanismo de
// deduplicacion: dedupKey evita, por ejemplo, mandar "stock bajo" del mismo
// producto mas de una vez el mismo dia aunque se vendan varias unidades.
model NotificationLog {
  id         String   @id @default(cuid())
  type       String
  channel    String   // WHATSAPP | EMAIL
  recipient  String
  entityType String?
  entityId   String?
  dedupKey   String?
  status     String   // SENT | FAILED
  error      String?
  createdAt  DateTime @default(now())

  @@index([dedupKey])
  @@index([createdAt])
  @@map("notification_logs")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          String       @id @default(cuid())
  action      String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  entityType  String
  entityId    String
  before      String?
  after       String?
  description String?
  createdAt   DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// ETAPA 2 — PEDIDOS POR WHATSAPP (base, sin lógica de bot todavía)
// ─────────────────────────────────────────────
// Valid values:
// WhatsAppOrder.status: NUEVO, CONFIRMADO, ENTREGADO, CANCELADO
// WhatsAppOrder.deliveryType: RECOGER, ENTREGA

model WhatsAppOrder {
  id             String   @id @default(cuid())
  code           String   @unique
  customerPhone  String
  customerName   String?
  status         String   @default("NUEVO")
  deliveryType   String
  paymentMethod  String?
  total          Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines WhatsAppOrderLine[]

  @@index([status])
  @@index([customerPhone])
  @@map("whatsapp_orders")
}

model WhatsAppOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       WhatsAppOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  quantity    Decimal
  unitPrice   Decimal
  lineTotal   Decimal

  @@index([orderId])
  @@map("whatsapp_order_lines")
}

// ─────────────────────────────────────────────
// TRANSFERENCIAS DE INVENTARIO ENTRE SUCURSALES
// ─────────────────────────────────────────────
// Flujo: PENDING (creada, no toca stock) -> IN_TRANSIT (se envio: descuenta
// stock de fromBranch, crea StockMovement TRANSFER_OUT ahi) -> RECEIVED (se
// recibio: suma stock a toBranch, crea StockMovement TRANSFER_IN ahi).
// CANCELLED solo es valido antes de enviar (todavia PENDING).

model StockTransfer {
  id            String    @id @default(cuid())
  code          String    @unique
  fromBranchId  String
  fromBranch    Branch    @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId    String
  toBranch      Branch    @relation("TransferTo", fields: [toBranchId], references: [id])
  status        String    @default("PENDING")
  requestedById String
  requestedBy   User      @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  receivedById  String?
  receivedBy    User?     @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  receivedAt    DateTime?

  lines StockTransferLine[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  productName String
  quantity    Decimal

  @@index([transferId])
  @@map("stock_transfer_lines")
}
